{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "Long-term, episodic, semantic, and preference memories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "scope": { "type": "string" },
        "type": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "importance": { "type": "number" },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "key", "value"]
    },
    "UserGoal": {
      "title": "UserGoal",
      "description": "Strategic goals with milestones and progress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "deadline": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserProject": {
      "title": "UserProject",
      "description": "Active projects linked to goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "goalId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "progress": { "type": "number" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserTask": {
      "title": "UserTask",
      "description": "Contextual tasks with energy windows and deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "UserCalendarEvent": {
      "title": "UserCalendarEvent",
      "description": "Schedule events and meetings with prep briefings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "focusType": { "type": "string" }
      },
      "required": ["id", "userId", "title", "startTime"]
    },
    "UserAsset": {
      "title": "UserAsset",
      "description": "Generated images, music, video, and artifacts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "music", "video"] },
        "prompt": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "prompt", "url", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile data"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "UserMemory" },
      "description": "Personal memories and learned context"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "UserGoal" },
      "description": "User goals and targets"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "UserProject" },
      "description": "Projects associated with goals"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "UserTask" },
      "description": "User prioritized tasks"
    },
    "/users/{userId}/calendar/{eventId}": {
      "schema": { "$ref": "UserCalendarEvent" },
      "description": "Calendar events and meetings"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": { "$ref": "UserAsset" },
      "description": "Assets generated by the user"
    }
  }
}

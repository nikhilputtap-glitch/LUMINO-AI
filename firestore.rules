rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolated User Data Tree
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // All user subcollections: profile, memories, conversations, goals, projects, tasks, calendar, automations, knowledge, activity, usage, auditLogs, assets
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /{subcollection}/{docId}/{nestedSubcollection}/{nestedDocId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
